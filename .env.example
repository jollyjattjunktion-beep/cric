# Cricket AI Broadcaster - Web Server Configuration
#
# YouTube stream key and match language are entered in the web UI at
# start time, not here. These two variables only affect how the local
# server binds.

PORT=8088
HOST=0.0.0.0

# Optional: Sarvam AI text-to-speech key, used as a fallback when the
# "Sarvam AI (Male Voice)" engine is selected in the web UI without pasting
# a key there directly.
SARVAM_API_KEY=

# VoiceStudio self-hosted TTS (optional; required only when provider=voicestudio)
# Use the Render private service host:port, or a local VoiceStudio server URL.
VOICESTUDIO_BASE_URL=
# Keep the admin API key in Render Environment settings; never commit its value.
VOICESTUDIO_API_KEY=
# Create your own voice profile in VoiceStudio, then set its voice_id here.
VOICESTUDIO_VOICE_ID=
VOICESTUDIO_MODEL=omnivoice
VOICESTUDIO_TTS_TIMEOUT_SECONDS=30
# Optional engine-specific style instruction. Verify support for the selected engine.
VOICESTUDIO_INSTRUCTIONS=
