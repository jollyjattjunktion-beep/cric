# Cricket AI Broadcaster - Web Server Configuration
PORT=8088
HOST=0.0.0.0

SARVAM_API_KEY=

# VoiceStudio (optional)
VOICESTUDIO_BASE_URL=
VOICESTUDIO_API_KEY=
VOICESTUDIO_VOICE_ID=
VOICESTUDIO_MODEL=omnivoice
VOICESTUDIO_TTS_TIMEOUT_SECONDS=30
VOICESTUDIO_INSTRUCTIONS=

# Svara TTS v1 (optional; run Kenpath/svara-tts-inference as a separate service)
SVARA_BASE_URL=
SVARA_API_KEY=  # Optional; stock Svara API ignores this unless protected by an auth proxy
SVARA_MODEL=svara-tts-v1
# Official male voice IDs: hi_male, pa_male, en_male.
SVARA_VOICE=hi_male
SVARA_TTS_TIMEOUT_SECONDS=30
# Keep the authorized reference recording on private persistent storage.
# Do NOT commit the recording to this public GitHub repository.
SVARA_REFERENCE_AUDIO_PATH=
# Exact words spoken in the reference audio improve zero-shot cloning quality.
SVARA_REFERENCE_TRANSCRIPT=
# Optional model emotion tag: <happy>, <sad>, <anger>, <fear>, or <clear>.
SVARA_STYLE_TAG=
